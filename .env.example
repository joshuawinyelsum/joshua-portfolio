# Joshua Winyelsum Portfolio - Environment Variables
# Copy this file to .env.local for local development.
# On Vercel, configure these under Project Settings > Environment Variables.

# -----------------------------------------------------------------------------
# Transactional Email Provider (Resend)
# -----------------------------------------------------------------------------
# Resend API key for direct contact form message delivery.
# Get your free API key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# The recipient email address where contact messages are delivered.
# Defaults to akumjoshuawin@gmail.com if not specified.
CONTACT_TO_EMAIL=akumjoshuawin@gmail.com

# Verified sender identity in Resend.
# For testing: use Resend's default sandbox domain: "Portfolio Contact <onboarding@resend.dev>"
# For production: verify your custom domain on Resend (e.g., "Joshua Winyelsum <contact@joshuawinyelsum.com>")
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
